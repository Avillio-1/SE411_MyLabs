{
  "info": {
    "name": "SE411 Lab13 - Spring Product API",
    "description": "Start the Lab13 server before running this collection. A negative product ID must return 400 Bad Request.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "List all products",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/products"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"JSON response\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"json\"));",
              "pm.test(\"All 17 products are returned\", () => { const rows = pm.response.json(); pm.expect(rows.length).to.eql(17); pm.expect(rows.map(p => p.id)).to.eql(Array.from({length: 17}, (_, i) => i + 10)); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Find product 10",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/products/10"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"JSON response\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"json\"));",
              "pm.test(\"Product fields match\", () => { const p = pm.response.json(); pm.expect(p).to.deep.equal({id: 10, name: \"3d printer\", description: \"A beginner friendly 3d printer\", price: 1840.25}); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Unknown positive ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/products/999"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 404\", () => pm.response.to.have.status(404));",
              "pm.test(\"JSON response\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"json\"));",
              "pm.test(\"Problem status\", () => pm.expect(pm.response.json().status).to.eql(404));"
            ]
          }
        }
      ]
    },
    {
      "name": "Negative ID - lab question",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/products/-1"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 400\", () => pm.response.to.have.status(400));",
              "pm.test(\"JSON response\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"json\"));",
              "pm.test(\"Problem status\", () => pm.expect(pm.response.json().status).to.eql(400));"
            ]
          }
        }
      ]
    },
    {
      "name": "Zero ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/products/0"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 400\", () => pm.response.to.have.status(400));",
              "pm.test(\"JSON response\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"json\"));",
              "pm.test(\"Problem status\", () => pm.expect(pm.response.json().status).to.eql(400));"
            ]
          }
        }
      ]
    },
    {
      "name": "Non-numeric ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/products/abc"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 400\", () => pm.response.to.have.status(400));",
              "pm.test(\"JSON response\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"json\"));",
              "pm.test(\"Problem status\", () => pm.expect(pm.response.json().status).to.eql(400));"
            ]
          }
        }
      ]
    },
    {
      "name": "Overflowing ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/products/2147483648"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 400\", () => pm.response.to.have.status(400));",
              "pm.test(\"JSON response\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"json\"));",
              "pm.test(\"Problem status\", () => pm.expect(pm.response.json().status).to.eql(400));"
            ]
          }
        }
      ]
    }
  ]
}
